# =====================================================================
# TTA-Glicko2-WHR: Environment Configuration & Credentials Template
# =====================================================================
# Copy this file to '.env' and fill in your confidential values:
#   copy .env.example .env
#
# NOTE: '.env' is strictly gitignored and will never be committed or 
# exposed to AI agents.
# =====================================================================

# ---------------------------------------------------------------------
# 1. CGE Tournament Scraper Authentication (account.czechgames.com)
# ---------------------------------------------------------------------
# Option A: Login Credentials (automatically signs into CGE)
CGE_USERNAME=your_cge_username_or_email
CGE_PASSWORD=your_cge_password

# Option B (Alternative): Direct Session Cookie (leave blank if using Option A)
# In browser: DevTools (F12) -> Application -> Cookies -> PHPSESSID
CGE_SESSION_COOKIE=

# ---------------------------------------------------------------------
# 2. Webmaster Administration Portal Access
# ---------------------------------------------------------------------
# Password required to log into http://127.0.0.1:5050/admin
ADMIN_PASSWORD=change_me_to_a_secure_password

# Secret key for Flask session cookie signing (any random string)
SECRET_KEY=generate_a_random_secret_key_here_for_sessions

# ---------------------------------------------------------------------
# 3. Scraper Etiquette & Rate Limiting Settings
# ---------------------------------------------------------------------
# Delay in seconds between HTTP requests to CGE servers (anti-bot etiquette)
CGE_MIN_DELAY=2.5
CGE_MAX_DELAY=5.0
